    "version": "0.2.0",
    "configurations": [
        {
            "name": "ChatServer",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "websockets/cmd/server/main.go",
            "env": {
                "PGHOST": "localhost",
                "PGPASSWORD": "password",
                "MIGRATIONS_FILE_PATH": "${workspaceFolder}/sql/migrations" //open just the chatserver project
            }
        },
        {
            "name": "UserService",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "http/cmd/server/main.go",
            "env": {
                "PGHOST": "localhost",
                "PGPASSWORD": "password",
                "MIGRATIONS_FILE_PATH": "${workspaceFolder}/sql/migrations" //open just the chatserver project
            }
        },
        {
            "name": "Test ChatServer",
            "request": "launch",
            "type": "bashdb",
            "program": "test.sh"
        }
    ]
}